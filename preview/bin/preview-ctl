#!/usr/bin/env bash
# =============================================================================
# preview-ctl — the ONLY thing that changes feature-branch preview state on the
# preview host. Every command is idempotent and runs under one flock, so a
# deploy, a teardown and the nightly reconciler can never interleave.
#
#   registry.json   single source of truth (what exists, ports, last push)
#   <slug>/shell/   the preview's host-shell build      (if the branch has one)
#   <slug>/cdn/<n>/ the preview's MFE builds            (per changed MFE)
#   <slug>/be/<n>/  the preview's backend dist + .env   (per changed backend)
#   <slug>/site/<n>/   a standalone static app on its own host (sso, portals)
#   <slug>/next/<n>/   a Next.js app under pm2, on its own host
#   _deps/<repo>/<lockhash>/node_modules   shared prod deps, symlinked in
#
# Anything a preview does NOT contain falls back to develop (dev-cdn / dev-api /
# dev-dashboard) through the generated nginx config — see render_nginx.
#
# Commands:
#   deploy   --slug S --branch B --repo R --kind fe|shell|be|site|next --name N
#            --sha SHA [--health /path] [--lockhash H] [--spa]
#            [--host pr-...DOMAIN --dev-host dev-x.DOMAIN]   (site/next only)
#   remove   --slug S [--repo R]        (prints REMOVED_HOST=<fqdn> for every
#                                        extra host dropped, REMOVED_PREVIEW=0|1 last)
#   sleep    --slug S                   (stop backends, keep files)
#   wake     --slug S
#   list                                (registry JSON)
#   deps-present --repo R --lockhash H  (exit 0 if shared deps exist)
#   prune-deps                          (drop unreferenced _deps)
#   render                              (regenerate nginx + reload)
# =============================================================================
set -euo pipefail

# Host config. preview.env holds on-host settings (PATH, overrides); ci.env is
# rewritten by the preview workflows from GitHub secrets (DEV_ORIGIN,
# PROD_SUPABASE_HOST) on every run and wins. The *_FILE overrides only exist so
# the specs can sandbox them.
PREVIEW_ENV_FILE=${PREVIEW_ENV_FILE:-/etc/so360-preview/preview.env}
PREVIEW_CI_ENV_FILE=${PREVIEW_CI_ENV_FILE:-/etc/so360-preview/ci.env}
if [ -f "$PREVIEW_ENV_FILE" ]; then . "$PREVIEW_ENV_FILE"; fi
if [ -f "$PREVIEW_CI_ENV_FILE" ]; then . "$PREVIEW_CI_ENV_FILE"; fi

ROOT=${PREVIEW_ROOT:-/srv/previews}
REG="$ROOT/registry.json"
INCOMING="$ROOT/_incoming"
DEPS="$ROOT/_deps"
DOMAIN=${PREVIEW_DOMAIN:-skyoffice360.com}
NGINX_OUT=${PREVIEW_NGINX_OUT:-/etc/nginx/conf.d/so360-previews.conf}
SSL_CERT=${PREVIEW_SSL_CERT:-/etc/ssl/cloudflare/skyoffice360.com.crt}
SSL_KEY=${PREVIEW_SSL_KEY:-/etc/ssl/cloudflare/skyoffice360.com.key}
PORT_MIN=${PREVIEW_PORT_MIN:-7100}
PORT_MAX=${PREVIEW_PORT_MAX:-7999}
PM2_MEM=${PREVIEW_PM2_MEM:-300M}
PM2_MEM_NEXT=${PREVIEW_PM2_MEM_NEXT:-600M}
DOMAIN_RE=$(sed 's/\./\\./g' <<<"$DOMAIN")

# Server-side calls from Next apps use the same 127.0.0.1:<port> addresses as
# on the Dev VM. The preview host answers them with loopback listeners that
# proxy to develop's services on dev-api (rendered only while a Next preview
# exists). name:port, matching dev-api's /<name>/ routes.
DEV_SERVICES="core:6000 crm:6003 inventory:6006 accounting:6008 projects:6010
timesheet:6012 people:6015 inbox:6017 neura:6018 storefront:6020 flow:6021
insight:6023 subscription:6026 forms:6027 dailystore:6029 fulfillment:6032
support:6033 manufacturing:6034 chat:6036 documents:6037 sign:6038
mobility:6040 folio:6044 connect:6048 signal:6049"

die() { echo "preview-ctl: $*" >&2; exit 1; }
now() { date -u +%s; }

valid_slug() { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?$ ]] || die "invalid slug '$1'"; }
valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,40}$ ]] || die "invalid name '$1'"; }
valid_repo() { [[ "$1" =~ ^[A-Za-z0-9._-]{1,100}$ ]] || die "invalid repo '$1'"; }
valid_hash() { [[ "$1" =~ ^[a-f0-9]{8,64}$ ]] || die "invalid lockhash '$1'"; }
# An extra host is its own DNS name + Access app: one label under DOMAIN,
# starting pr- so the catch-all server and the teardown prefix match it.
valid_host() {
  [[ "$1" =~ ^pr-[a-z0-9]([a-z0-9-]*[a-z0-9])?\.$DOMAIN_RE$ ]] || die "invalid host '$1' (must be pr-<label>.$DOMAIN)"
  [ "${#1}" -le $((${#DOMAIN} + 64)) ] || die "invalid host '$1' (label longer than 63)"
}
# The dev hostname a site/next app is published on; rewritten to the preview host.
valid_dev_host() {
  [[ "$1" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] || die "invalid dev host '$1'"
  case "$1" in
    dev-cdn.skyoffice360.com|dev-api.skyoffice360.com|dev-dashboard.skyoffice360.com)
      die "dev host '$1' is already rewritten by the overlay" ;;
  esac
}

lock() {
  mkdir -p "$ROOT" "$INCOMING" "$DEPS"
  exec 9>"$ROOT/.lock"
  flock -w 600 9 || die "could not take the preview lock within 10 minutes"
}

reg_read() { if [ -s "$REG" ]; then cat "$REG"; else echo '{"previews":{}}'; fi; }

# Validate before replacing: a truncated registry would orphan every preview.
reg_write() {
  local tmp; tmp=$(mktemp "$ROOT/.registry.XXXXXX")
  cat >"$tmp"
  jq -e '.previews | type == "object"' "$tmp" >/dev/null || { rm -f "$tmp"; die "refusing to write a malformed registry"; }
  mv "$tmp" "$REG"
}

# jq filter applied to the registry in place.
reg_apply() { reg_read | jq "$@" | reg_write; }

pm2_name() { echo "pv-$1-$2"; }

port_in_use() { ss -Hltn "sport = :$1" 2>/dev/null | grep -q .; }

alloc_port() {
  local slug=$1 repo=$2 existing used p
  existing=$(reg_read | jq -r --arg s "$slug" --arg r "$repo" '.previews[$s].components[$r].port // empty')
  if [ -n "$existing" ]; then echo "$existing"; return; fi
  used=$(reg_read | jq -r '[.previews[].components[] | .port // empty] | .[]')
  for ((p = PORT_MIN; p <= PORT_MAX; p++)); do
    grep -qx "$p" <<<"$used" && continue
    port_in_use "$p" && continue
    echo "$p"; return
  done
  die "no free preview port in $PORT_MIN-$PORT_MAX"
}

# Swap a freshly rsynced directory into place so nginx never serves half a build.
swap_in() {
  local src=$1 dst=$2
  [ -d "$src" ] || die "nothing uploaded at $src"
  mkdir -p "$(dirname "$dst")"
  rm -rf "$dst.old"
  [ -e "$dst" ] && mv "$dst" "$dst.old"
  mv "$src" "$dst"
  rm -rf "$dst.old"
}

# ── Backend guard rails ──────────────────────────────────────────────────────
# A preview backend runs branch code nobody has reviewed yet. It must never
# point at the production database and must never run schedulers or queue
# consumers that would compete with dev/prod for the same jobs.
harden_env() {
  local env=$1 port=$2
  [ -f "$env" ] || die "backend upload has no .env"
  if [ -n "${PROD_SUPABASE_HOST:-}" ] && grep -qF "$PROD_SUPABASE_HOST" "$env"; then
    die "backend .env references the production database ($PROD_SUPABASE_HOST) — previews need a non-prod database"
  fi
  sed -i -E '/^(PORT|SO360_PREVIEW|EVENT_WORKERS_DISABLED|SIGNAL_EVENT_CONSUMER_DISABLED|SIGNAL_RULES_SWEEP)=/d' "$env"
  {
    echo "PORT=$port"
    echo "SO360_PREVIEW=true"
    echo "EVENT_WORKERS_DISABLED=true"
    echo "SIGNAL_EVENT_CONSUMER_DISABLED=true"
    echo "SIGNAL_RULES_SWEEP=off"
  } >>"$env"
  chmod 600 "$env"
}

# A Next preview is a frontend server: it keeps develop's public Supabase
# URL/anon key (like every other frontend preview) but never a service-role
# key, so server code can do no more than the signed-in user could.
harden_next_env() {
  local env=$1
  [ -f "$env" ] || die "next upload has no .env.local"
  sed -i -E '/^[A-Za-z0-9_]*(SERVICE_KEY|SERVICE_ROLE)[A-Za-z0-9_]*=/d; /^(PORT|HOSTNAME|SO360_PREVIEW)=/d' "$env"
  echo "SO360_PREVIEW=true" >>"$env"
  chmod 600 "$env"
}

# Standalone builds (output: 'standalone') run their own server.js and need
# static/public/.env.local copied beside it, as the Dev VM deploy does.
next_prepare_standalone() {
  local dir=$1 sa="$1/.next/standalone"
  [ -f "$sa/server.js" ] || return 0
  rm -rf "$sa/.next/static" "$sa/public"
  mkdir -p "$sa/.next"
  [ -d "$dir/.next/static" ] && cp -a "$dir/.next/static" "$sa/.next/static"
  [ -d "$dir/public" ] && cp -a "$dir/public" "$sa/public"
  cp "$dir/.env.local" "$sa/.env.local"
  chmod 600 "$sa/.env.local"
}

start_backend() {
  local slug=$1 name=$2 dir=$3 port=$4 health=$5 kind=${6:-be} pname main
  pname=$(pm2_name "$slug" "$name")
  pm2 delete "$pname" >/dev/null 2>&1 || true
  if [ "$kind" = next ]; then
    if [ -f "$dir/.next/standalone/server.js" ]; then
      NODE_ENV=production PORT=$port HOSTNAME=127.0.0.1 pm2 start "$dir/.next/standalone/server.js" \
        --name "$pname" --cwd "$dir/.next/standalone" --instances 1 \
        --max-memory-restart "$PM2_MEM_NEXT" --time --update-env >/dev/null
    else
      [ -f "$dir/node_modules/next/dist/bin/next" ] || die "no next binary in $dir/node_modules"
      NODE_ENV=production PORT=$port pm2 start "$dir/node_modules/next/dist/bin/next" \
        --name "$pname" --cwd "$dir" --instances 1 \
        --max-memory-restart "$PM2_MEM_NEXT" --time --update-env -- start -p "$port" -H 127.0.0.1 >/dev/null
    fi
  else
    main=$(find "$dir/dist" -name main.js -not -path '*/node_modules/*' | head -1)
    [ -n "$main" ] || die "no dist/**/main.js in $dir"
    PORT=$port pm2 start "$main" --name "$pname" --cwd "$dir" --instances 1 \
      --max-memory-restart "$PM2_MEM" --time --update-env >/dev/null
  fi
  local i
  for i in $(seq 1 30); do
    if curl -fsS -o /dev/null "http://127.0.0.1:$port$health"; then
      echo "health ok: $pname on :$port"
      return 0
    fi
    sleep 2
  done
  pm2 logs "$pname" --lines 60 --nostream || true
  pm2 stop "$pname" >/dev/null 2>&1 || true
  return 1
}

# ── Commands ─────────────────────────────────────────────────────────────────
cmd_deploy() {
  local slug="" branch="" repo="" kind="" name="" sha="" health="" lockhash=""
  local spa=false host="" dev_host=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) slug=$2; shift 2 ;; --branch) branch=$2; shift 2 ;;
      --repo) repo=$2; shift 2 ;; --kind) kind=$2; shift 2 ;;
      --name) name=$2; shift 2 ;; --sha) sha=$2; shift 2 ;;
      --health) health=$2; shift 2 ;; --lockhash) lockhash=$2; shift 2 ;;
      --host) host=$2; shift 2 ;; --dev-host) dev_host=$2; shift 2 ;;
      --spa) spa=true; shift ;;
      *) die "deploy: unknown flag $1" ;;
    esac
  done
  valid_slug "$slug"; valid_repo "$repo"; valid_name "$name"
  [ -n "$branch" ] && [ -n "$sha" ] || die "deploy: --branch and --sha are required"
  if [ -z "$health" ]; then
    if [ "$kind" = next ]; then health="/"; else health="/health"; fi
  fi
  [[ "$health" =~ ^/[A-Za-z0-9/_.-]*$ ]] || die "invalid health path"
  if [ "$spa" = true ] && [ "$kind" != fe ]; then die "deploy: --spa only applies to --kind fe"; fi
  case "$kind" in
    site|next)
      valid_host "$host"
      [ "$host" != "pr-$slug.$DOMAIN" ] || die "deploy: --host must differ from the preview's main host"
      [ -z "$dev_host" ] || valid_dev_host "$dev_host"
      local owner
      owner=$(reg_read | jq -r --arg h "$host" --arg s "$slug" --arg r "$repo" \
        '.previews | to_entries[] | .key as $k | .value.components | to_entries[]
         | select(.value.host == $h and ($k != $s or .key != $r)) | "\($k)/\(.key)"' | head -1)
      [ -z "$owner" ] || die "deploy: host $host already belongs to $owner"
      ;;
    *) [ -z "$host" ] && [ -z "$dev_host" ] || die "deploy: --host/--dev-host only apply to --kind site or next" ;;
  esac

  local src="$INCOMING/$slug/$repo" base="$ROOT/$slug" port="null" ts
  ts=$(now)
  case "$kind" in
    fe)    swap_in "$src" "$base/cdn/$name" ;;
    shell) swap_in "$src" "$base/shell" ;;
    site)  swap_in "$src" "$base/site/$name" ;;
    be)
      valid_hash "$lockhash"
      link_deps "$repo" "$lockhash"
      swap_in "$src" "$base/be/$name"
      ln -sfn "$DEPS/$repo/$lockhash/node_modules" "$base/be/$name/node_modules"
      port=$(alloc_port "$slug" "$repo")
      harden_env "$base/be/$name/.env" "$port"
      ;;
    next)
      [ -d "$src" ] || die "nothing uploaded at $src"
      if [ ! -f "$src/.next/standalone/server.js" ]; then
        valid_hash "$lockhash"
        link_deps "$repo" "$lockhash"
      else
        lockhash=""
      fi
      swap_in "$src" "$base/next/$name"
      if [ -n "$lockhash" ]; then ln -sfn "$DEPS/$repo/$lockhash/node_modules" "$base/next/$name/node_modules"; fi
      harden_next_env "$base/next/$name/.env.local"
      next_prepare_standalone "$base/next/$name"
      port=$(alloc_port "$slug" "$repo")
      ;;
    *) die "deploy: --kind must be fe, shell, be, site or next" ;;
  esac

  reg_apply --arg s "$slug" --arg b "$branch" --arg r "$repo" --arg k "$kind" \
    --arg n "$name" --arg sha "$sha" --arg h "$health" --arg lh "$lockhash" \
    --arg host "$host" --arg dh "$dev_host" --argjson spa "$spa" \
    --argjson p "$port" --argjson ts "$ts" '
    .previews[$s] = ((.previews[$s] // {created: $ts, components: {}})
      | .branch = $b | .last_push = $ts | .asleep = false
      | .components[$r] = ({kind: $k, name: $n, sha: $sha, deployed: $ts,
                           port: $p, health: $h, lockhash: (if $lh == "" then null else $lh end)}
          + (if $spa then {spa: true} else {} end)
          + (if $host == "" then {} else {host: $host} end)
          + (if $dh == "" then {} else {dev_host: $dh} end)))'

  if [ "$kind" = be ] || [ "$kind" = next ]; then
    start_backend "$slug" "$name" "$base/$kind/$name" "$port" "$health" "$kind" \
      || die "$repo did not become healthy on :$port"
    pm2 save >/dev/null
  fi
  # A push wakes the whole preview, not only the component that changed.
  wake_backends "$slug"
  render_nginx
  echo "PREVIEW_URL=https://pr-$slug.$DOMAIN"
  if [ -n "$host" ]; then echo "PREVIEW_HOST_URL=https://$host"; fi
}

# Shared prod deps by lockfile hash: move a fresh upload into the store, or
# reuse what is there.
link_deps() {
  local repo=$1 lockhash=$2 dep="$DEPS/$1/$2"
  if [ ! -d "$dep/node_modules" ]; then
    [ -d "$INCOMING/_deps/$repo/$lockhash/node_modules" ] || die "deps $repo@$lockhash neither present nor uploaded"
    mkdir -p "$DEPS/$repo"
    rm -rf "$dep"
    mv "$INCOMING/_deps/$repo/$lockhash" "$dep"
  fi
  rm -rf "$INCOMING/_deps/$repo/$lockhash"
  touch "$dep"
}

# Components that run under pm2.
PROC_SELECT='select(.kind == "be" or .kind == "next")'

stop_backends() {
  local slug=$1 name
  for name in $(reg_read | jq -r --arg s "$slug" ".previews[\$s].components // {} | .[] | $PROC_SELECT | .name"); do
    pm2 stop "$(pm2_name "$slug" "$name")" >/dev/null 2>&1 || true
  done
}

wake_backends() {
  local slug=$1 name port health kind
  while IFS=$'\t' read -r name port health kind; do
    [ -n "$name" ] || continue
    local pname; pname=$(pm2_name "$slug" "$name")
    if ! pm2 describe "$pname" 2>/dev/null | grep -q "status.*online"; then
      start_backend "$slug" "$name" "$ROOT/$slug/$kind/$name" "$port" "$health" "$kind" \
        || echo "::warning::$pname failed to wake"
    fi
  done < <(reg_read | jq -r --arg s "$slug" ".previews[\$s].components // {} | .[] | $PROC_SELECT | [.name, .port, .health, .kind] | @tsv")
  reg_apply --arg s "$slug" 'if .previews[$s] then .previews[$s].asleep = false else . end'
  pm2 save >/dev/null 2>&1 || true
}

cmd_remove() {
  local slug="" repo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --slug) slug=$2; shift 2 ;; --repo) repo=$2; shift 2 ;;
      *) die "remove: unknown flag $1" ;;
    esac
  done
  valid_slug "$slug"
  local base="$ROOT/$slug"
  if [ -n "$repo" ]; then
    valid_repo "$repo"
    local comp kind name
    comp=$(reg_read | jq -c --arg s "$slug" --arg r "$repo" '.previews[$s].components[$r] // empty')
    if [ -n "$comp" ]; then
      kind=$(jq -r .kind <<<"$comp"); name=$(jq -r .name <<<"$comp")
      case "$kind" in
        fe)    rm -rf "$base/cdn/$name" ;;
        shell) rm -rf "$base/shell" ;;
        site)  rm -rf "$base/site/$name" ;;
        be|next)
               pm2 delete "$(pm2_name "$slug" "$name")" >/dev/null 2>&1 || true
               pm2 save >/dev/null 2>&1 || true
               rm -rf "${base:?}/$kind/$name" ;;
      esac
      jq -r '.host // empty | "REMOVED_HOST=\(.)"' <<<"$comp"
      reg_apply --arg s "$slug" --arg r "$repo" 'del(.previews[$s].components[$r])'
    fi
    # Last component gone → the preview itself goes.
    if [ "$(reg_read | jq --arg s "$slug" '.previews[$s].components // {} | length')" != 0 ]; then
      render_nginx
      echo "REMOVED_PREVIEW=0"
      return
    fi
  fi
  local name
  for name in $(reg_read | jq -r --arg s "$slug" ".previews[\$s].components // {} | .[] | $PROC_SELECT | .name"); do
    pm2 delete "$(pm2_name "$slug" "$name")" >/dev/null 2>&1 || true
  done
  reg_read | jq -r --arg s "$slug" '.previews[$s].components // {} | .[] | .host // empty | "REMOVED_HOST=\(.)"'
  pm2 save >/dev/null 2>&1 || true
  rm -rf "$base" "$INCOMING/$slug"
  reg_apply --arg s "$slug" 'del(.previews[$s])'
  render_nginx
  echo "REMOVED_PREVIEW=1"
}

cmd_sleep() {
  [ "${1:-}" = --slug ] || die "usage: sleep --slug S"
  valid_slug "$2"
  stop_backends "$2"
  pm2 save >/dev/null 2>&1 || true
  reg_apply --arg s "$2" 'if .previews[$s] then .previews[$s].asleep = true else . end'
}

cmd_wake() {
  [ "${1:-}" = --slug ] || die "usage: wake --slug S"
  valid_slug "$2"
  wake_backends "$2"
}

cmd_deps_present() {
  local repo="" hash=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo=$2; shift 2 ;; --lockhash) hash=$2; shift 2 ;;
      *) die "deps-present: unknown flag $1" ;;
    esac
  done
  valid_repo "$repo"; valid_hash "$hash"
  [ -d "$DEPS/$repo/$hash/node_modules" ]
}

cmd_prune_deps() {
  local keep dir
  keep=$(reg_read | jq -r '.previews | to_entries[] | .value.components | to_entries[] | select(.value.lockhash) | "\(.key)/\(.value.lockhash)"')
  for dir in "$DEPS"/*/*; do
    [ -d "$dir" ] || continue
    grep -qx "${dir#"$DEPS"/}" <<<"$keep" && continue
    # Leave anything touched in the last day: a deploy may be mid-flight.
    [ -n "$(find "$dir" -maxdepth 0 -mtime +0)" ] || continue
    echo "pruning $dir"; rm -rf "$dir"
  done
}

# ── nginx ────────────────────────────────────────────────────────────────────
# One generated file. Everything a preview lacks is proxied to the Dev VM
# origin directly (not through Cloudflare — dev-dashboard sits behind Access),
# and every dev hostname inside HTML/JS/CSS/JSON is rewritten to this preview's
# host by the shared snippet, so an unchanged develop shell loads the
# preview's MFEs and APIs without being rebuilt.
render_nginx() {
  [ -n "${DEV_ORIGIN:-}" ] || die "DEV_ORIGIN is not set in $PREVIEW_CI_ENV_FILE (PREVIEW_DEV_ORIGIN secret) or $PREVIEW_ENV_FILE"
  local tmp slug
  install -d -m 700 -o www-data /var/cache/nginx/so360-preview 2>/dev/null || install -d -m 700 /var/cache/nginx/so360-preview
  tmp=$(mktemp)
  {
    echo "# GENERATED by preview-ctl at $(date -u +%FT%TZ) — do not edit; run 'preview-ctl render'."
    echo "proxy_cache_path /var/cache/nginx/so360-preview levels=1:2 keys_zone=so360pv:20m max_size=2g inactive=7d use_temp_path=off;"
    # pr-<50-char slug>.<domain> is ~70 chars; the default 64-byte bucket rejects it.
    echo "server_names_hash_bucket_size 128;"
    echo "upstream so360_dev_origin { server $DEV_ORIGIN:443; keepalive 16; }"
    echo "map \$http_upgrade \$pv_connection_upgrade { default upgrade; '' ''; }"
    # Only hashed build assets are safe to cache; index.html, remoteEntry.js and
    # anything else must always come fresh from develop (dev sends no Cache-Control).
    echo "map \$uri \$pv_nocache { ~remoteEntry\\.js\$ 1; ~/assets/ 0; default 1; }"
    cat <<EOF
server {
    listen 80;
    server_name ~^pr-[a-z0-9-]+\\.$DOMAIN_RE\$;
    return 301 https://\$host\$request_uri;
}
server {
    listen 443 ssl http2;
    server_name ~^pr-[a-z0-9-]+\\.$DOMAIN_RE\$;
    ssl_certificate     $SSL_CERT;
    ssl_certificate_key $SSL_KEY;
    default_type text/plain;
    add_header X-Robots-Tag "noindex, nofollow" always;
    return 404 "No preview is deployed for this branch (yet).\\n";
}
EOF
    if [ "$(reg_read | jq '[.previews[].components[] | select(.kind == "next")] | length')" != 0 ]; then
      render_loopback
    fi
    for slug in $(reg_read | jq -r '.previews | keys[]'); do
      render_server "$slug"
    done
  } >"$tmp"

  local backup=""
  if [ -f "$NGINX_OUT" ]; then backup=$(mktemp); cp "$NGINX_OUT" "$backup"; fi
  mv "$tmp" "$NGINX_OUT"
  chmod 644 "$NGINX_OUT"
  if nginx -t >/dev/null 2>&1; then
    if systemctl is-active --quiet nginx; then systemctl reload nginx; else systemctl start nginx; fi
    if [ -n "$backup" ]; then rm -f "$backup"; fi
  else
    nginx -t || true
    if [ -n "$backup" ]; then mv "$backup" "$NGINX_OUT"; else rm -f "$NGINX_OUT"; fi
    die "generated nginx config failed 'nginx -t' — previous config restored"
  fi
}

# develop's service ports on loopback, for Next server-side calls.
render_loopback() {
  local svc name port
  echo
  echo "# ── develop services on loopback (Next previews' server-side calls) ──"
  for svc in $DEV_SERVICES; do
    name=${svc%%:*}; port=${svc##*:}
    cat <<EOF
server {
    listen 127.0.0.1:$port;
    location / {
        proxy_pass https://so360_dev_origin/$name/;
        proxy_ssl_server_name on;
        proxy_ssl_name dev-api.skyoffice360.com;
        proxy_set_header Host dev-api.skyoffice360.com;
        include /etc/nginx/snippets/so360-preview-api.conf;
    }
}
EOF
  done
}

# Server-block head shared by every host of a preview: TLS, identity, and the
# rewrite of each extra app's dev hostname to its preview host.
server_head() {
  local slug=$1 host=$2 comps=$3 api_base=$4 cdn_base=$5
  cat <<EOF
server {
    listen 443 ssl http2;
    server_name $host;
    ssl_certificate     $SSL_CERT;
    ssl_certificate_key $SSL_KEY;
    set \$pv_slug $slug;
    set \$pv_main_host pr-$slug.$DOMAIN;
    set \$pv_api_base $api_base;
    set \$pv_cdn_base $cdn_base;
    include /etc/nginx/snippets/so360-preview-common.conf;
EOF
  jq -r '.[] | select(.dev_host and .host) | "    sub_filter '"'"'https://\(.dev_host)'"'"' '"'"'https://\(.host)'"'"';"' <<<"$comps"
}

render_server() {
  local slug=$1 host="pr-$1.$DOMAIN" base="$ROOT/$1" comps name port spa xhost
  comps=$(reg_read | jq -c --arg s "$slug" '.previews[$s].components')
  echo
  echo "# ── $slug ($(reg_read | jq -r --arg s "$slug" '.previews[$s].branch')) ──"
  server_head "$slug" "$host" "$comps" "$host/api" "$host/cdn"
  echo "    include /etc/nginx/snippets/so360-preview-overlay.conf;"
  # Preview MFEs, served from disk.
  while IFS=$'\t' read -r name spa; do
    [ -n "$name" ] || continue
    if [ "$spa" = true ]; then
      cat <<EOF
    location ^~ /cdn/$name/ {
        alias $base/cdn/$name/;
        try_files \$uri /cdn/$name/index.html;  # standalone SPA under /cdn/$name/
        include /etc/nginx/snippets/so360-preview-static.conf;
    }
EOF
    else
      cat <<EOF
    location ^~ /cdn/$name/ {
        alias $base/cdn/$name/;
        try_files \$uri =404;  # MFE bundles are fetched by path; no SPA fallback
        include /etc/nginx/snippets/so360-preview-static.conf;
    }
EOF
    fi
  done < <(jq -r '.[] | select(.kind == "fe") | [.name, (.spa // false)] | @tsv' <<<"$comps")
  # Preview backends, on their pm2 port.
  while IFS=$'\t' read -r name port; do
    [ -n "$name" ] || continue
    cat <<EOF
    location ^~ /api/$name/ {
        rewrite ^/api/$name/(.*)\$ /\$1 break;
        proxy_pass http://127.0.0.1:$port;
        include /etc/nginx/snippets/so360-preview-api.conf;
        error_page 502 503 504 = @asleep;
    }
EOF
  done < <(jq -r '.[] | select(.kind == "be") | [.name, .port] | @tsv' <<<"$comps")
  # Host shell: the preview's own build, else develop's.
  if [ -n "$(jq -r '.[] | select(.kind == "shell") | .name' <<<"$comps")" ]; then
    cat <<EOF
    location / {
        root $base/shell;
        try_files \$uri \$uri/ /index.html =404;
        include /etc/nginx/snippets/so360-preview-static.conf;
    }
}
EOF
  else
    cat <<EOF
    location / {
        set \$pv_upstream_host dev-dashboard.skyoffice360.com;
        include /etc/nginx/snippets/so360-preview-fallback.conf;
    }
}
EOF
  fi
  # Standalone static apps, each on its own host with the same overlay.
  while IFS=$'\t' read -r name xhost; do
    [ -n "$name" ] || continue
    server_head "$slug" "$xhost" "$comps" "$xhost/api" "$xhost/cdn"
    cat <<EOF
    include /etc/nginx/snippets/so360-preview-overlay.conf;
    location / {
        root $base/site/$name;
        try_files \$uri \$uri/ /index.html =404;
        include /etc/nginx/snippets/so360-preview-static.conf;
    }
}
EOF
  done < <(jq -r '.[] | select(.kind == "site") | [.name, .host] | @tsv' <<<"$comps")
  # Next apps on their pm2 port. They own /api, so develop's services are
  # reached through /__so360api/ on the same host instead.
  while IFS=$'\t' read -r name xhost port; do
    [ -n "$name" ] || continue
    server_head "$slug" "$xhost" "$comps" "$xhost/__so360api" "pr-$slug.$DOMAIN/cdn"
    cat <<EOF
    location ^~ /__so360api/ {
        rewrite ^/__so360api/(.*)\$ /\$1 break;
        include /etc/nginx/snippets/so360-preview-devapi.conf;
    }
    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_set_header Host \$host;
        include /etc/nginx/snippets/so360-preview-api.conf;
        error_page 502 503 504 = @asleep;
    }
}
EOF
  done < <(jq -r '.[] | select(.kind == "next") | [.name, .host, .port] | @tsv' <<<"$comps")
}

# ── Dispatch ─────────────────────────────────────────────────────────────────
cmd=${1:-}; shift || true
case "$cmd" in
  deploy)       lock; cmd_deploy "$@" ;;
  remove)       lock; cmd_remove "$@" ;;
  sleep)        lock; cmd_sleep "$@" ;;
  wake)         lock; cmd_wake "$@" ;;
  prune-deps)   lock; cmd_prune_deps ;;
  render)       lock; render_nginx ;;
  list)         reg_read ;;
  deps-present) cmd_deps_present "$@" ;;
  *) echo "usage: preview-ctl deploy|remove|sleep|wake|list|deps-present|prune-deps|render (see header)" >&2; exit 2 ;;
esac
