# /etc/nb-autoscaler.env (mode 600, owner nbci). Values are NOT committed.
ORG=Neonbee-ai
GCP_PROJECT=gen-lang-client-0521938031
GCP_ZONES=europe-west1-b,europe-west1-c,europe-west1-d
GCLOUD=/usr/bin/gcloud
# PAT of moonhive-neonbee: org self-hosted runners admin + repo actions read (+ pull requests write for PROMOTE_REPOS)
GH_TOKEN_FILE=/etc/nb-autoscaler.gh-token
MAX_VCPU=32
IDLE_S=180
POLL_S=30
TEAMS_WEBHOOK=
# Merge train + develop promotion + Pulse released. Pilot first, '*' = all repos later.
TRAIN_REPOS=so360-accounting-fe,so360-folio-fe
# Pulse MCP endpoint (POST JSON-RPC) + PM token of the release bot user; stage key for "released"
PULSE_MCP_URL=
PULSE_TOKEN_FILE=/etc/nb-autoscaler.pulse-token
PULSE_RELEASED_STATUS=released
# 1 = log every action, change nothing (default). Set 0 only after a clean dry-run hour.
DRY_RUN=1
