# systemd unit for the Internal Tools VM (167.114.98.177). Installed by install-itvm.sh.
[Unit]
Description=Neonbee CI autoscaler (GCP Spot runners, fallback runner, merge train)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
User=nbci
EnvironmentFile=/etc/nb-autoscaler.env
StateDirectory=nb-autoscaler
ExecStart=/usr/bin/python3 /opt/nb-autoscaler/runner/autoscaler/nb_autoscaler.py loop
Restart=always
RestartSec=10
# A pass that hangs (stuck API call) is killed and restarted; each pass pings the watchdog.
WatchdogSec=600
NotifyAccess=main

[Install]
WantedBy=multi-user.target
